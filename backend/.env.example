# Metro Cardz — Backend Environment Variables
# =============================================
# 100% Hostinger VPS — No Supabase, No Render
# Copy this to .env and fill in your values.

# -------------------------------------------------------
# Database — PostgreSQL running locally on the VPS
# -------------------------------------------------------
DATABASE_URL=postgresql://metrocardz_user:YOUR_DB_PASSWORD@localhost:5432/metrocardz

# -------------------------------------------------------
# Redis — running locally on the VPS
# -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------------------
# JWT / Security
# Generate: python3.11 -c "import secrets; print(secrets.token_hex(32))"
# -------------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-string-of-at-least-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# -------------------------------------------------------
# App Config
# -------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
APP_NAME=Metro Cardz API
APP_VERSION=1.0.0

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=https://metrocardz.in,https://www.metrocardz.in

# -------------------------------------------------------
# Local File Storage (Hostinger VPS disk — served by Nginx)
# Nginx serves https://api.metrocardz.in/uploads/ from this directory.
# FastAPI also mounts /uploads for dev/fallback.
# -------------------------------------------------------
UPLOADS_DIR=/var/www/metrocardz/uploads

# -------------------------------------------------------
# SMS Gateway (Msg91) — Required for OTP login
# Sign up at: https://msg91.com
# -------------------------------------------------------
MSG91_API_KEY=
MSG91_SENDER_ID=METRCZ
MSG91_TEMPLATE_ID_OTP=

# -------------------------------------------------------
# WhatsApp BSP (AiSensy) — Optional, for birthday/reminder messages
# Sign up at: https://aisensy.com
# -------------------------------------------------------
AISENSY_API_KEY=
AISENSY_CAMPAIGN_NAME=metrocardz_reminder

# -------------------------------------------------------
# Internal Cron Auth Key (for /internal/* endpoints)
# Generate: python3.11 -c "import secrets; print(secrets.token_hex(16))"
# -------------------------------------------------------
INTERNAL_CRON_KEY=

# -------------------------------------------------------
# Sentry (Error Tracking — free tier, optional)
# Get DSN from: sentry.io → New Project → Python → FastAPI
# -------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# -------------------------------------------------------
# Google Wallet (optional — for digital wallet passes)
# -------------------------------------------------------
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_JSON_PATH=/etc/metrocardz/google_wallet_sa.json

# -------------------------------------------------------
# Super Admin (first admin user — created on first startup)
# IMPORTANT: Change to YOUR real phone number before deploy!
# -------------------------------------------------------
SUPER_ADMIN_PHONE=9000000000
SUPER_ADMIN_NAME=Metro Cardz Admin
