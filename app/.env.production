# Metro Cardz — Production Environment Variables
# Hostinger Web App Hosting (Node.js 22.x)
# Set these in: hPanel → Web Apps → Your App → Environment Variables
# DO NOT commit real secrets to Git.

# -------------------------------------------------------
# Database — Hostinger MySQL
# hPanel → Databases → MySQL Databases
# -------------------------------------------------------
DATABASE_URL=mysql://u446352478_mcardz_user:YOUR_DB_PASSWORD@localhost:3306/u446352478_metrocardz

# -------------------------------------------------------
# JWT — Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Each must be a DIFFERENT random value
# -------------------------------------------------------
JWT_SECRET=GENERATE_64_HEX_CHARS_HERE
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_64_HEX_CHARS_HERE
NEXTAUTH_SECRET=GENERATE_YET_ANOTHER_64_HEX_CHARS_HERE
NEXTAUTH_URL=https://metrocardz.com
ADMIN_SESSION_MAX_AGE=86400

# -------------------------------------------------------
# AES-256 Encryption (for PII phone numbers stored in MySQL)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be exactly 64 hex characters
# -------------------------------------------------------
ENCRYPTION_KEY=GENERATE_64_HEX_CHARS_HERE

# -------------------------------------------------------
# OTP Security
# -------------------------------------------------------
OTP_HMAC_SECRET=GENERATE_ANOTHER_RANDOM_SECRET_HERE

# -------------------------------------------------------
# App Config
# -------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Metro Cardz
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_BASE_URL=https://metrocardz.com
NEXT_PUBLIC_UPLOAD_URL=https://metrocardz.com/uploads
NEXT_PUBLIC_USE_MOCK_DATA=false

# -------------------------------------------------------
# Cron Key — protects /api/v1/cron/* endpoints
# Set in Hostinger Cron Job header: X-Cron-Key: YOUR_KEY
# -------------------------------------------------------
INTERNAL_CRON_KEY=GENERATE_32_HEX_CHARS_HERE

# -------------------------------------------------------
# Optional — leave empty to disable
# -------------------------------------------------------
NEXT_PUBLIC_ENABLE_SENTRY=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
BLOCKED_IPS=
