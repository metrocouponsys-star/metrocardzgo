# Metro Cardz — Deals Platform Environment Variables (Template)
# =============================================
# Copy this file to .env.local for local development.
# For production: set these in Hostinger hPanel → Web Apps → Environment Variables
#
# Hosting:  Hostinger Web App Hosting
# Database: MySQL (Hostinger-managed)
# Auth:     JWT + bcrypt (admin only)

# -------------------------------------------------------
# Database — Hostinger MySQL
# Hostinger hPanel → Databases → MySQL Databases
# Format: mysql://USER:PASSWORD@HOST:3306/DB_NAME
# -------------------------------------------------------
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/metrocardz"

# -------------------------------------------------------
# Auth / JWT
# Generate: openssl rand -base64 32
# -------------------------------------------------------
NEXTAUTH_SECRET="<generate-random-secret>"
NEXTAUTH_URL="https://metrocardz.in"
ADMIN_SESSION_MAX_AGE=86400

# -------------------------------------------------------
# App Config
# -------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Metro Cardz
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=development

# Public base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# -------------------------------------------------------
# Feature Flags
# -------------------------------------------------------
NEXT_PUBLIC_USE_MOCK_DATA=false

# -------------------------------------------------------
# Sentry (Error Tracking — optional)
# -------------------------------------------------------
NEXT_PUBLIC_ENABLE_SENTRY=false
NEXT_PUBLIC_SENTRY_DSN=

# -------------------------------------------------------
# Analytics (Google Analytics — optional)
# -------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
