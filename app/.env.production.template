# ═══════════════════════════════════════════════════════════════════════════════
# Metro Cardz — Production Environment Variables
# Hostinger Web App Hosting
# Website: https://metrocardz.com
# Server:  server1127 | Asia (India)
# Node.js: 22.x
# Database: MySQL (Hostinger managed)
#
# HOW TO SET IN HOSTINGER:
#   hPanel → Web App → Your App → Environment Variables
#   Paste each variable as Key=Value (one per row)
#
# NEVER commit this file with real values to Git.
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# DATABASE — Hostinger MySQL
# Find in: hPanel → Databases → MySQL Databases
# ───────────────────────────────────────────────────────────────────────────────
# Format: mysql://USERNAME:PASSWORD@localhost:3306/DATABASE_NAME
# Note: Host is ALWAYS 'localhost' on Hostinger shared hosting
DATABASE_URL=mysql://u446352478_mcardz_user:YOUR_DB_PASSWORD@localhost:3306/u446352478_metrocardz

# ───────────────────────────────────────────────────────────────────────────────
# JWT AUTHENTICATION
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ───────────────────────────────────────────────────────────────────────────────
JWT_SECRET=GENERATE_AND_PASTE_64_HEX_CHARS_HERE
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_64_HEX_CHARS_HERE
NEXTAUTH_SECRET=GENERATE_YET_ANOTHER_64_HEX_CHARS_HERE
NEXTAUTH_URL=https://metrocardz.com
ADMIN_SESSION_MAX_AGE=86400

# ───────────────────────────────────────────────────────────────────────────────
# FIELD ENCRYPTION (AES-256-GCM) — for PII like phone numbers stored in MySQL
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be exactly 64 hex characters (32 bytes)
# ───────────────────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=GENERATE_64_HEX_CHARS_HERE_32_BYTES

# ───────────────────────────────────────────────────────────────────────────────
# OTP SECURITY (HMAC-based OTP generation)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ───────────────────────────────────────────────────────────────────────────────
OTP_HMAC_SECRET=GENERATE_ANOTHER_RANDOM_SECRET_HERE

# ───────────────────────────────────────────────────────────────────────────────
# APP CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Metro Cardz
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=production

# Public URL — used in QR codes, canonical links, OG tags
NEXT_PUBLIC_BASE_URL=https://metrocardz.com

# ───────────────────────────────────────────────────────────────────────────────
# FILE UPLOADS — Stored on Hostinger disk at public_html/uploads/
# Served at: https://metrocardz.com/uploads/
# ───────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_UPLOAD_URL=https://metrocardz.com/uploads

# ───────────────────────────────────────────────────────────────────────────────
# SMS (MSG91) — Required for OTP login
# Register at: https://msg91.com
# ───────────────────────────────────────────────────────────────────────────────
MSG91_API_KEY=
MSG91_SENDER_ID=METRCZ
MSG91_TEMPLATE_ID_OTP=

# ───────────────────────────────────────────────────────────────────────────────
# WHATSAPP (AiSensy) — Optional, for birthday & reminder messages
# Register at: https://aisensy.com
# ───────────────────────────────────────────────────────────────────────────────
AISENSY_API_KEY=
AISENSY_CAMPAIGN_NAME=metrocardz_reminder

# ───────────────────────────────────────────────────────────────────────────────
# CRON / SCHEDULED JOBS — Internal API key for /api/v1/cron/* endpoints
# Called by Hostinger Cron Jobs (hPanel → Hosting → Cron Jobs)
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# ───────────────────────────────────────────────────────────────────────────────
INTERNAL_CRON_KEY=GENERATE_32_HEX_CHARS_HERE

# ───────────────────────────────────────────────────────────────────────────────
# SECURITY — Blocked IPs (comma-separated, optional)
# ───────────────────────────────────────────────────────────────────────────────
BLOCKED_IPS=

# ───────────────────────────────────────────────────────────────────────────────
# SENTRY (Error tracking — free tier)
# Register at: sentry.io → New Project → Next.js
# ───────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_SENTRY=false
NEXT_PUBLIC_SENTRY_DSN=

# ───────────────────────────────────────────────────────────────────────────────
# ANALYTICS (Google Analytics 4 — optional)
# ───────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ───────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ───────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_USE_MOCK_DATA=false
