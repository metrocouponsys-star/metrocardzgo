# Metro Cardz — Deals Platform Environment Variables
# Copy this file to .env.local for local development

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Get these from: Supabase Dashboard > Project Settings > Database > Connection String
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Deals Admin JWT ────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
DEALS_ADMIN_JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION"

# ── Admin seed config ──────────────────────────────────────────────────────────
# Only used during `npm run db:seed` — change admin password immediately after seeding
DEALS_ADMIN_EMAIL="admin@metrocardz.in"
DEALS_ADMIN_INITIAL_PASSWORD="ChangeMe123!"

# ── App URL ────────────────────────────────────────────────────────────────────
# Used for server-side fetches (ISR, metadata generation)
# Local dev: http://localhost:3000
# Production: https://metrocardz.in (or your Hostinger domain)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── Existing Supabase config (unchanged from existing app) ────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[your-anon-key]"
